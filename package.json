{
  "name": "seamtag",
  "version": "3.2.0",
  "description": "Label images in LabelMe, Pascal VOC, YOLO or CreateML format: polygons, boxes, brush and eraser, AI segmentation, and review of model proposals",
  "license": "GPL-3.0-only",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "onnxruntime-node": "^1.23.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.48.2",
    "@types/d3-contour": "^3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "clipper-lib": "^6.4.2",
    "d3-contour": "^4.0.2",
    "electron": "^44.10.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "productName": "Seamtag",
  "author": {
    "name": "Jakhongir Nodirov",
    "email": "jakhon37@gmail.com"
  },
  "homepage": "https://github.com/jakhon37/Seamtag"
}
